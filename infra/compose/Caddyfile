# Public ingress (docker-compose.caddy.yml). Values come from the
# environment; `varlatch setup` writes them to .env.
{
	acme_ca {$VARLATCH_ACME_CA}
}

{$VARLATCH_PUBLIC_HOST} {
	encode zstd gzip
	# The dashboard serves the UI, /v1 and /convex (WebSocket) same-origin.
	reverse_proxy varlatch-web:80
}
