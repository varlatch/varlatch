# Copy to .env and set real values. Generate passwords with: openssl rand -hex 24
POSTGRES_SUPERUSER_PASSWORD=
VARLATCH_MIGRATE_PASSWORD=
VARLATCH_RUNTIME_PASSWORD=

# Host interface for the published ports. Keep loopback: the ingress in
# front (Caddy, the Tailscale sidecar, or your own TLS proxy) is the only way
# in. Passkeys need HTTPS, so publishing these ports on a LAN lets no one sign
# in; put a TLS proxy in front instead.
BIND_ADDRESS=127.0.0.1
# Host port of the dashboard (varlatch-web). It also serves varlatchd's API
# (/auth, /v1, /enroll, /readyz, /.well-known) and Convex at /convex, so a
# reverse proxy forwards the public URL here, WebSocket upgrades included.
VARLATCH_WEB_PORT=8787
# Host ports of varlatchd and the Convex backend, for local checks only.
# Never route a public domain at varlatchd's port: passkey sign-in works only
# at the public URL. An installation that keeps a separate Convex origin
# forwards it to CONVEX_PORT. varlatch setup writes 0 for both: a free port
# Docker picks.
VARLATCHD_PORT=8686
CONVEX_PORT=3210

# Root KEK file on the HOST. secrets/ is gitignored, so clone-based deploys
# (Coolify) must point this at a persistent file outside the checkout,
# e.g. /data/varlatch/varlatch-kek. Generate with: openssl rand -hex 32
# Never store the KEK itself in an env var / Coolify's env settings (ADR-0011).
VARLATCH_KEK_HOST_PATH=./secrets/varlatch-kek

# Convex Application Plane
CONVEX_DB_PASSWORD=
CONVEX_INSTANCE_SECRET=

# Alternatively give any secret above as a host file mounted only into the
# services that need it (#28) — required to keep secrets separated on
# Coolify, which passes every variable to every service. Set the path and
# leave the variable empty; a set variable wins over its file. Files must be
# readable by the container users (e.g. 0644 inside a 0700 directory).
# POSTGRES_SUPERUSER_PASSWORD_HOST_PATH=
# VARLATCH_MIGRATE_PASSWORD_HOST_PATH=
# VARLATCH_RUNTIME_PASSWORD_HOST_PATH=
# CONVEX_DB_PASSWORD_HOST_PATH=
# CONVEX_INSTANCE_SECRET_HOST_PATH=
# TS_AUTHKEY_HOST_PATH=
# Optional, existing installations only: the convex-deploy job derives the
# Convex admin key from CONVEX_INSTANCE_SECRET inside its own container
# (ADR-0035 D3). Leave empty for new installations.
CONVEX_ADMIN_KEY=
# The browser-facing Convex origin. With one public origin (recommended,
# ADR-0035 D5) this is the dashboard URL plus /convex, e.g.
# https://app.<your-domain>/convex: varlatch-web proxies it to Convex.
# A separate origin (convex.<your-domain>) also works. Defaults suit local
# use. varlatch-web serves CONVEX_CLOUD_ORIGIN to the browser as runtime
# config, read when its container is created: apply a change with
# `docker compose up -d`, since a restart keeps the old value.
CONVEX_CLOUD_ORIGIN=http://127.0.0.1:3210
CONVEX_SITE_ORIGIN=http://127.0.0.1:3211

# The BROWSER-facing origin of the dashboard (varlatch-web proxies /auth, /v1,
# /enroll and /.well-known to varlatchd, so this is one origin). It is the
# WebAuthn rpID/origin, the JWT issuer, and the enroll-link base — passkey
# sign-in fails if it differs from the URL users actually visit.
# Real deployments: https://app.<your-domain>
VARLATCH_PUBLIC_URL=http://localhost:8787
# JWKS as fetched BY the convex container (internal network URL is fine)
VARLATCH_JWKS_URL=http://varlatchd:8686/.well-known/jwks.json
VARLATCH_CONVEX_URL=http://convex-backend:3210

# Sync delivery: off disables all adapters; otherwise restrict with a comma-separated allowlist.
VARLATCH_SYNC=on
VARLATCH_SYNC_ADAPTERS=

# Proxies whose X-Forwarded-For varlatchd trusts: Compose service names, IP
# addresses, or CIDR ranges, comma-separated. The default is varlatch-web,
# plus caddy, tailscale, or coolify-proxy with those overlays; a value here
# replaces it, so keep those names in the list.
# VARLATCH_TRUSTED_PROXIES=varlatch-web

# Ingress overlays. varlatch setup writes these for the public and tailnet
# ingress; set them yourself only when you run an overlay by hand.
# COMPOSE_FILE=docker-compose.yml:docker-compose.caddy.yml
# Public ingress (docker-compose.caddy.yml): the host name of
# VARLATCH_PUBLIC_URL, which Caddy obtains a certificate for, the ACME
# directory, and the host ports Caddy listens on.
# VARLATCH_PUBLIC_HOST=app.<your-domain>
# VARLATCH_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
# VARLATCH_HTTP_PORT=80
# VARLATCH_HTTPS_PORT=443
# Tailscale (docker-compose.tailscale.yml): give the auth key as a file
# (TS_AUTHKEY_HOST_PATH above), and set your tailnet's MagicDNS suffix and
# the machine name the node asks for.
# VARLATCH_TAILNET_NAME=<tailnet>.ts.net
# VARLATCH_TAILNET_MACHINE=varlatch
