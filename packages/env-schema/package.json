{
  "name": "@varlatch/env-schema",
  "version": "0.14.1",
  "private": true,
  "description": "The .env.schema parser: the contract file format pushed with `varlatch contract push --schema`, parsed into a Contract draft",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@varlatch/contract": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.5.0",
    "typescript": "5.9.2",
    "vitest": "4.1.11"
  }
}
