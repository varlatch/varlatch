{
  "name": "@varlatch/mcp-server",
  "version": "0.14.2",
  "private": true,
  "description": "Model Context Protocol server for varlatch: metadata and (opt-in) non-secret writes, never a Secret's value; run as `varlatch mcp`",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "varlatch-mcp": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./run": {
      "types": "./dist/run.d.ts",
      "default": "./dist/run.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "@varlatch/context": "workspace:*",
    "@varlatch/protocol": "workspace:*",
    "@varlatch/sdk": "workspace:*",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "26.5.0",
    "typescript": "5.9.2",
    "vitest": "4.1.11"
  }
}
