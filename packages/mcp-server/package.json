{
  "name": "@varlatch/mcp-server",
  "version": "0.12.0",
  "private": true,
  "description": "Model Context Protocol server exposing varlatch metadata, values, and (opt-in) writes/disclosures to MCP hosts",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "varlatch-mcp": "./dist/main.js"
  },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@varlatch/context": "workspace:*",
    "@varlatch/protocol": "workspace:*",
    "@varlatch/sdk": "workspace:*",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "26.5.0",
    "typescript": "5.9.2",
    "vitest": "4.1.11"
  }
}
