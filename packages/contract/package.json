{
  "name": "@varlatch/contract",
  "version": "0.14.1",
  "private": true,
  "description": "Canonical Varlatch Configuration Contract model, normalization, content hashing, semantic diffing, and versioned Contract Semantics",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./semantics": {
      "types": "./dist/semantics.d.ts",
      "default": "./dist/semantics.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/node": "26.5.0",
    "typescript": "5.9.2",
    "vitest": "4.1.11"
  }
}
