# SPDX-License-Identifier: Apache-2.0
#
# /etc/varlatch/varlatchd.conf: varlatchd's configuration (ADR-0059).
# varlatch setup writes it; varlatchd.service reads it, read-only, with
#   varlatchd serve --config /etc/varlatch/varlatchd.conf
# It holds no secrets: the Root KEK reaches varlatchd as the systemd
# credential root-kek, never through this file or the environment.
#
# Format: one setting per line, `name = value`. Blank lines and lines that
# start with # are ignored. The value is the rest of the line with the
# blanks around it removed, taken as written: no quotes, escapes or comments
# after it. An empty value means the default. An unknown name, a name given
# twice, a line without = or a value varlatchd cannot use is a configuration
# error: varlatchd exits with status 78 and systemd does not restart it
# (RestartPreventExitStatus=78) until the file is fixed.
#
# Every setting, with its default:

# The HTTP listener, address:port. An empty address listens on every
# address.
listen = 127.0.0.1:8686

# The origin people reach Varlatch at, such as https://varlatch.example.com
# (no path). It must be https, except on this machine: plain http is
# accepted only for localhost, 127.0.0.1 and [::1], and varlatchd refuses
# to start with any other plain-http address. Default: none.
public_url =

# The data directory, which holds the database (varlatch.db). Default: the
# unit's state directory, /var/lib/varlatch.
data_dir =

# The file the Root KEK is read from. Default: the root-kek credential
# systemd hands the unit ($CREDENTIALS_DIRECTORY/root-kek).
root_kek_file =

# Proxies whose X-Forwarded-For varlatchd believes: comma-separated IP
# addresses, CIDR ranges and host names. The client address is read from the
# right of the header, through these proxies only. Default: none.
trusted_proxies =

# Where the access log goes: one JSON line per request, with its arrival
# and completion time, client address, method, path (never the query),
# status and X-Forwarded-For. An absolute path, stdout (the journal) or off.
access_log = stdout

# The outbound policy's allow list (ADR-0057): what Organizations may reach
# beyond public https destinations (webhooks, sync platforms, OIDC
# issuers), comma-separated. A host name or *.suffix opens its private
# addresses; a CIDR range or an address opens that range (a loopback,
# link-local or metadata range only by an entry inside it); an entry may
# end in :port or :* (any port), and without one allows the scheme's
# default port; plain http needs an entry. Unspecified, multicast and
# reserved addresses are never allowed. Default: nothing beyond public
# https. See https://docs.varlatch.com/reference/outbound-policy/
outbound_allow =

# Outbound sync (ADR-0031): on lets authorized users configure Sync
# Targets; off turns the feature off for the installation.
sync = on

# The sync adapters to allow, comma-separated, out of github-actions,
# coolify and convex. Default: all.
sync_adapters =

# The audit export to object storage (ADR-0056): on lets an
# Organization's admins copy its audit log to their own S3-compatible
# bucket; off refuses creating or changing one (removing one still works).
audit_export = on

# Backups (ADR-0059 Decision 7): an encrypted archive of the database and
# this configuration's non-key settings, made while varlatchd serves. The
# Backup Encryption Key's file (32 bytes, hex or base64), kept apart from
# the Root KEK and held off this host too: an archive cannot be restored
# without it. Without it, varlatchd makes no scheduled backup. Default: none.
backup_key_file =

# How often a scheduled backup runs, from 1h to 744h, or off. Default: 24h.
backup_interval = 24h

# How many archives stay in the data directory's backups directory; older
# ones are removed there (never at a destination). Default: 7.
backup_keep = 7

# The destinations file: the S3 or B2 buckets archives can be uploaded to,
# each with its region, bucket, prefix and the file of its write key.
# Default: none, archives stay on this host.
backup_destinations_file =

# The destination, by its name in that file, each archive is uploaded to.
# Default: offsite.
backup_destination = offsite

# The tailnet listener (ADR-0059 Decision 5): on starts varlatchd's own
# Tailscale node, in process, and serves the API on its tailnet address,
# where each request carries the verified identity of the device it came
# from. The node is always tagged, joins Tailscale's coordination server
# (a self-hosted one is not supported yet), and pins its tailnet at
# enrolment. Default: off.
tailnet = off

# With tailnet = on: the node's host name, fixed at enrolment; the tags
# its auth key grants, comma-separated; and the tailnet listener's port.
#tailnet_hostname = varlatch
#tailnet_tags = tag:varlatch
#tailnet_port = 8687

# The auth key's file, read only to enrol the node the first time.
# Default: the tailnet-auth-key credential in $CREDENTIALS_DIRECTORY.
#tailnet_auth_key_file =

# The browser endpoint (ADR-0046), off unless its port is set: the API
# over HTTPS on the node's tailnet name, with the node's own certificate
# (MagicDNS and HTTPS certificates on in the tailnet), for the dashboard to
# read tailnet-protected values from a browser on a tailnet device. The
# certificate's name, <tailnet_hostname>.<tailnet>.ts.net, is published in
# Certificate Transparency logs. Allowed dashboard origins: an https (or
# loopback http) public_url's, and these exact origins, comma-separated.
#tailnet_https_port = 8443
#tailnet_browser_origins =

# Public HTTPS (step 6's decision 4): varlatchd serves HTTPS itself on
# listen_https, with a certificate for public_url's host name (an https
# public_url naming a DNS name is required) that it obtains and renews
# over ACME (Let's Encrypt by default), and never serves anything over
# HTTPS before it has one. The certificate and the ACME account key stay
# in <data_dir>/acme (0700), never in a backup: a restored installation
# obtains its certificate again. Off (unset) keeps the installation as it
# is: the plain listener above, behind your own proxy or on this machine.
# No Strict-Transport-Security header is sent; add one at your own proxy or
# CDN if you want browsers to remember HTTPS for this name. With it on,
# listen must be a loopback address, and its clients connect directly: no
# X-Forwarded-For is believed on it (trusted_proxies is listen's).
#listen_https = :443
# The plain HTTP listener: ACME HTTP-01 challenges and a redirect of
# everything else to public_url, never a page. Default: port 80 on
# listen_https's address; off leaves TLS-ALPN-01, on listen_https, as the
# only challenge.
#listen_http_redirect = :80
# The ACME account's contact address, for the CA's expiry notices.
#acme_email = ops@example.com
# The ACME directory. Default: Let's Encrypt. Its staging directory,
# https://acme-staging-v02.api.letsencrypt.org/directory, issues
# certificates no browser trusts, for a trial run.
#acme_ca =
# A PEM file of roots trusted for the CA's own API (a private CA); default:
# the system's.
#acme_ca_root =

# Serving the CLI (ADR-0058 Decision 3), off by default: on, the
# installation serves this release's varlatch for Linux, macOS and Windows,
# and installers that install it from public_url (required):
#   curl -fsSLo install.sh <public_url>/install.sh && sh install.sh
# varlatchd downloads the release's files from github.com in the
# background, after checking that SHA256SUMS is signed by the release
# workflow of varlatch/varlatch for this version (the Sigstore trusted
# root comes from its TUF repository), keeps them in <data_dir>/cli, and
# checks them again at every start before serving anything. Installing
# from the installation trusts it, and whoever controls its address, to
# run code on the installing machine; the CLI it serves still checks the
# release signature before it is put in place.
#serve_cli = off
