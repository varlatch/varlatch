#
# The varlatchd systemd unit (ADR-0059 Decision 8). install.sh --server puts
# it in /etc/systemd/system; varlatch setup writes what it needs and starts
# it. What the service gets:
#
#   /var/lib/varlatch           its data (the database, tsnet's state),
#                               created by systemd, mode 0700, owned by the
#                               varlatch system user that setup creates
#   /etc/varlatch/varlatchd.conf
#                               its configuration (no secrets), written by
#                               setup, read-only to the service
#   $CREDENTIALS_DIRECTORY/root-kek, .../backup-key
#                               the Root KEK and the BEK (ADR-0011,
#                               ADR-0033): root-only files in /etc/varlatch
#                               on disk, handed to this service alone by
#                               systemd, never in its environment or
#                               configuration
#
# The rest of this file keeps varlatchd to what it needs: no privilege but
# binding ports 80 and 443, no access to the rest of the file system, and
# no way to gain more.

[Unit]
Description=Varlatch server
Documentation=https://docs.varlatch.com/
Wants=network-online.target
After=network-online.target
# Until setup has written them, starting would only fail.
AssertPathExists=/etc/varlatch/varlatchd.conf
AssertPathExists=/etc/varlatch/root-kek
AssertPathExists=/etc/varlatch/backup-key
# Never give up restarting: a secrets server left down after a passing
# outage (network, DNS, disk) is worse than a configuration error retried
# every 15 seconds, each try in the journal. (Backoff with RestartSteps
# needs systemd 254, newer than Debian 12's.)
StartLimitIntervalSec=0

[Service]
Type=exec
ExecStart=/usr/local/bin/varlatchd serve --config /etc/varlatch/varlatchd.conf
Restart=on-failure
RestartSec=15s
# 78 (EX_CONFIG) is a configuration error no restart can fix: an unparsable
# varlatchd.conf, an unknown or repeated setting, an invalid value, missing
# or unparsable Root KEK material, a Root KEK that is not this
# installation's. varlatchd says which in the journal, and stays stopped
# until it is fixed and started again.
RestartPreventExitStatus=78
# Long enough to let requests in flight finish and the writer commit.
TimeoutStopSec=30s
User=varlatch
Group=varlatch
UMask=0077

StateDirectory=varlatch
StateDirectoryMode=0700
LoadCredential=root-kek:/etc/varlatch/root-kek
LoadCredential=backup-key:/etc/varlatch/backup-key

# Ports 80 (ACME, redirects) and 443 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# File system: everything read-only but the state directory; /etc/varlatch
# is read through the configuration path and the credentials above.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# Other processes are hidden; /proc/net stays, which tsnet reads to find
# the default route.
ProtectProc=invisible
RemoveIPC=yes

# Network: IP for clients, ACME, backups and the tailnet; netlink for
# tsnet's view of the host's interfaces; Unix sockets for systemd.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# A private user namespace would leave CAP_NET_BIND_SERVICE without effect
# on the host's ports.
PrivateUsers=no
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
DevicePolicy=closed
KeyringMode=private

LimitNOFILE=65536
# A core dump would hold the Root KEK.
LimitCORE=0

[Install]
WantedBy=multi-user.target
