{
  "name": "@varlatch/cli",
  "version": "0.13.0",
  "private": true,
  "description": "The varlatch CLI (ADR-0017/0020): login, context, run, values, contracts, validation, audit",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "varlatch": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm run bundle",
    "bundle": "esbuild dist/main.js --bundle --platform=node --target=node22 --format=cjs --outfile=dist/varlatch.cjs '--banner:js=/*! Varlatch CLI. Copyright 2026 Robotsson. SPDX-License-Identifier: Apache-2.0. Bundled third-party licenses: THIRD-PARTY-NOTICES.md */'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@varlatch/accessor": "workspace:*",
    "@varlatch/accessor-python": "workspace:*",
    "@varlatch/backup": "workspace:*",
    "@varlatch/contract": "workspace:*",
    "@varlatch/context": "workspace:*",
    "@varlatch/protocol": "workspace:*",
    "@varlatch/sdk": "workspace:*",
    "@varlatch/sync": "workspace:*",
    "@varlatch/env-schema": "workspace:*",
    "@varlatch/matcher": "workspace:*",
    "@varlatch/mcp-server": "workspace:*",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@types/node": "26.5.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.2",
    "vitest": "4.1.11"
  }
}
